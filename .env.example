# PostgreSQL connection (e.g. Neon — copy "Connection string" from dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT signing for session cookies (use a long random string in production)
SESSION_SECRET="generate-a-long-random-string"

# Optional — FatSecret food search (server-side only; IP allowlist in FatSecret console)
# FATSECRET_CLIENT_ID=""
# FATSECRET_CLIENT_SECRET=""
